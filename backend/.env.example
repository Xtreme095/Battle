# Environment
NODE_ENV=development

# Server
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://battledawn:battledawn@localhost:5432/battledawn?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Game Configuration
GAME_TICK_RATE=1000
RESOURCE_UPDATE_INTERVAL=60000
BATTLE_RESOLUTION_DELAY=5000

# Logging
LOG_LEVEL=info
